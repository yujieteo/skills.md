.decide label:has(input[value=approve]:checked) { background: var(--good-bg); border-color: #b9d7be; color: var(--good); }
.decide label:has(input[value=reject]:checked) { background: var(--bad-bg); border-color: #f0cfc9; color: var(--bad); }
