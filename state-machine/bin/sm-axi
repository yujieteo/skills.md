<body><main id="app"></main>
<form class="bar" id="bar" data-lavish-question="state-machine-review"><span class="muted" id="count">No decisions yet.</span><button class="button" data-primary type="submit">Queue the review</button><span class="muted" role="status" aria-live="polite" id="status"></span></form>
<script>
const DATA = /*DATA*/null;
const $ = (tag, attrs = {}, ...kids) => { const e = document.createElement(tag); for (const [k, v] of Object.entries(attrs)) { if (v === false || v == null) continue; if (k === "text") e.textContent = v; else e.setAttribute(k, v === true ? "" : v); } e.append(...kids); return e; };
const NS = "http://www.w3.org/2000/svg";
// Text with \`code\` spans.
const rich = (t) => t.split("\u0060").map((x, i) => (i % 2 ? $("code", { text: x }) : document.createTextNode(x)));
const S = (tag, attrs = {}) => { const e = document.createElementNS(NS, tag); for (const [k, v] of Object.entries(attrs)) if (v !== false && v != null) e.setAttribute(k, v === true ? "" : v); return e; };
const reduce = matchMedia("(prefers-reduced-motion: reduce)");
const BUGS = { "unreachable": "unreachable state", "dead-end": "dead end", "unhandled": "unhandled events", "two-transitions": "two transitions on one state and event", "guard-gap": "guards do not cover all cases", "row-no-req": "row with no requirement", "req-no-row": "requirement with no row" };
const SIMP = { "merge-states": "equivalent states", "pass-through": "pass-through state", "global-event": "global event", "flag-guard": "flag in guards", "flag-states": "flag explosion", "function": "a plain function?" };
const app = document.getElementById("app");
const rowId = (m, r) => m + "-L" + r.line;
const lineFinds = (list, m, r) => list.filter((f) => f.machine === m && (f.line ? f.line === r.line : f.at === r.state + "/" + r.event));

function head() {
  const bugs = DATA.checks.length, simp = DATA.machines.reduce((n, m) => n + m.simplify.length, 0);
  const rows = DATA.machines.reduce((n, m) => n + m.rows.length, 0);
  app.append($("h1", { text: DATA.title }), $("p", { class: "muted", text: DATA.file + " · " + DATA.machines.length + " machine(s) · " + rows + " rows · " + DATA.reqs.length + " requirements" }));
  const v = $("ul", { class: "verdict" });
  if (DATA.bugs.length) v.append($("li", { "data-bad": true, text: DATA.bugs.length + " proven bug" + (DATA.bugs.length === 1 ? "" : "s") }));
  v.append($("li", { "data-bad": bugs > 0, text: bugs + " check finding" + (bugs === 1 ? "" : "s") }), $("li", { text: simp + " simplification" + (simp === 1 ? "" : "s") }));
  for (const m of DATA.machines) v.append($("li", { text: m.name + ": " + (m.rows.length / Math.max(1, new Set(m.rows.flatMap((r) => r.reqs)).size)).toFixed(1) + " rows per requirement" }));
  if (DATA.proposals.length) v.append($("li", { text: "simpler design below" }));
  app.append(v);
  for (const t of DATA.intro) app.append($("p", { class: "muted" }, ...rich(t)));
  if (DATA.bugs.length) {
    app.append($("h2", { text: "Proven bugs" }));
    const ul = $("ul", { class: "finds" });
    for (const b of DATA.bugs) ul.append($("li", { "data-bug": true }, $("b", { text: b.id }), ...rich(b.text + " Proof: "), $("code", { text: b.source })));
    app.append(ul, $("p", { class: "muted", text: "No fix lands before you approve the bug's row here." }));
  }
}

function findings() {
  const steps = [
    ["1. Question the requirements", DATA.checks.filter((f) => f.kind === "row-no-req" || f.kind === "req-no-row"), BUGS],
    ["3. Simplify", DATA.machines.flatMap((m) => m.simplify), SIMP],
    ["4. Kill bugs", DATA.checks.filter((f) => f.kind !== "row-no-req" && f.kind !== "req-no-row"), BUGS],
  ];
  app.append($("h2", { text: "Findings" }));
  for (const [title, list, names] of steps) {
    app.append($("h3", { text: title + " (" + list.length + ")" }));
    const ul = $("ul", { class: "finds" });
    if (!list.length) ul.append($("li", { class: "muted", text: "None." }));
    for (const f of list) {
      const li = $("li", {}, $("b", { text: names[f.kind] || f.kind }));
      const where = f.machine === "-" ? f.at : f.machine + " · " + f.at;
      if (f.line && f.machine !== "-") li.append($("a", { href: "#" + f.machine + "-L" + f.line, text: where }));
      else li.append(document.createTextNode(where));
      li.append(document.createTextNode(" — " + f.detail));
      ul.append(li);
    }
    app.append(ul);
  }
  for (const h of DATA.hidden) app.append($("p", { class: "muted", text: "Proposal " + h.name + " is not shown: " + h.reason + "." }));
}

// Layout: columns by distance from the initial state, unreachable states last.
function layout(m) {
  const depth = new Map([[m.initial, 0]]), order = [m.initial];
  for (let i = 0; i < order.length; i++) for (const r of m.rows) {
    const from = order[i];
    if ((r.state === from || r.state === "*") && r.next !== "-" && !depth.has(r.next)) { depth.set(r.next, depth.get(from) + 1); order.push(r.next); }
  }
  const max = Math.max(0, ...depth.values());
  for (const s of m.states) if (!depth.has(s)) { depth.set(s, max + 1); order.push(s); }
  const cols = [];
  for (const s of order) (cols[depth.get(s)] ||= []).push(s);
  const pos = new Map(); let x = 24, H = 40;
  cols.forEach((col) => {
    const w = Math.max(...col.map((s) => s.length * 7.6 + 28));
    col.forEach((s, i) => pos.set(s, { x, y: 64 + i * 110, w: s.length * 7.6 + 28, h: 36 }));
    x += w + 170;
    H = Math.max(H, 64 + col.length * 110);
  });
  return { pos, W: x - 140, H: H + 70 };
}
function edgePath(a, b, bend = 0) {
  if (a.x === b.x && a !== b) { const x = a.x + a.w, y1 = a.y + a.h / 2, y2 = b.y + b.h / 2, out = 40 + Math.abs(y2 - y1) * 0.2; return "M" + x + "," + y1 + " C" + (x + out) + "," + y1 + " " + (b.x + b.w + out) + "," + y2 + " " + (b.x + b.w) + "," + y2; }
  if (a === b) { const x = a.x + a.w / 2, y = a.y; return "M" + (x - 10) + "," + y + " C" + (x - 30) + "," + (y - 46) + " " + (x + 30) + "," + (y - 46) + " " + (x + 10) + "," + y; }
  if (b.x > a.x) { const x1 = a.x + a.w, y1 = a.y + a.h / 2 + bend, x2 = b.x, y2 = b.y + b.h / 2 + bend, dx = (x2 - x1) / 2; return "M" + x1 + "," + y1 + " C" + (x1 + dx) + "," + y1 + " " + (x2 - dx) + "," + y2 + " " + x2 + "," + y2; }
  const x1 = a.x + a.w / 2, y1 = a.y + a.h, x2 = b.x + b.w / 2, y2 = b.y + b.h, drop = 50 + Math.abs(x1 - x2) * 0.15 + bend;
  return "M" + x1 + "," + y1 + " C" + x1 + "," + (y1 + drop) + " " + x2 + "," + (y2 + drop) + " " + x2 + "," + y2;
}

function machine(m, host, bad) {
  const { pos, W, H } = layout(m);
  const svg = S("svg", { viewBox: "0 0 " + W + " " + H, style: "max-width:" + W + "px;min-width:" + Math.min(W, 520) + "px", role: "img", "aria-label": "State diagram of " + m.name });
  svg.append(Object.assign(S("defs"), { innerHTML: '<marker id="arrow-' + m.name + '" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#bcbbb5"/></marker>' }));
  const pairs = new Map();
  for (const r of m.rows) {
    if (r.next === "-" || r.state === "*") continue;
    const k = r.state + ">" + r.next;
    pairs.set(k, [...(pairs.get(k) || []), r]);
  }
  const labels = [];
  for (const [k, rs] of pairs) {
    const [s, n] = k.split(">");
    const p = S("path", { class: "edge", d: edgePath(pos.get(s), pos.get(n)), "marker-end": "url(#arrow-" + m.name + ")" });
    svg.append(p);
    labels.push([p, rs.map((r) => r.event + (r.guard ? " [" + r.guard + "]" : "")).join(", ")]);
  }
  const nodes = new Map();
  for (const s of m.states) {
    const b = pos.get(s);
    const g = S("g", { class: "node", "data-final": m.final.includes(s), "data-bad": bad.has(s) });
    g.append(S("rect", { x: b.x, y: b.y, width: b.w, height: b.h, rx: 8 }));
    const t = S("text", { x: b.x + b.w / 2, y: b.y + 23, "text-anchor": "middle" }); t.textContent = s; g.append(t);
    if (s === m.initial) { const d = S("circle", { cx: b.x - 10, cy: b.y + b.h / 2, r: 4, fill: "#63635e" }); svg.append(d); }
    svg.append(g); nodes.set(s, g);
  }
  const marker = S("circle", { class: "marker", r: 5, cx: 0, cy: 0 });
  svg.append(marker);
  const graph = $("div", { class: "graph" }, svg);
  host.append(graph);
  requestAnimationFrame(() => {
    for (const [p, text] of labels) {
      const pt = p.getPointAtLength(p.getTotalLength() / 2);
      const t = S("text", { class: "elabel", x: pt.x, y: pt.y - 4, "text-anchor": "middle" }); t.textContent = text.length > 46 ? text.slice(0, 44) + "…" : text;
      const title = S("title"); title.textContent = text; t.append(title);
      svg.insertBefore(t, nodes.values().next().value);
    }
  });
  simulator(m, host, pos, nodes, marker, svg);
}

// The simulator: fire an event, and the marker travels along the edge to the next state.
function simulator(m, host, pos, nodes, marker, svg) {
  let cur = m.initial, anim = null;
  const trail = $("div", { class: "trail", "aria-live": "polite" });
  const bar = $("div", { class: "sim" });
  const place = (s) => { const b = pos.get(s); marker.style.transform = "translate(" + (b.x + b.w - 8) + "px," + (b.y + 8) + "px)"; };
  const mark = () => { for (const [s, g] of nodes) g.toggleAttribute("data-current", s === cur); };
  const rowsFor = (s) => { const own = m.rows.filter((r) => r.state === s); return own.concat(m.rows.filter((r) => r.state === "*" && !own.some((o) => o.event === r.event && (!r.guard || o.guard.trim() === r.guard.trim())))); };
  function fire(r, e) {
    host.querySelectorAll("tr[data-fired]").forEach((t) => t.removeAttribute("data-fired"));
    document.getElementById(rowId(m.name, r))?.setAttribute("data-fired", "");
    const from = cur, to = r.next === "-" ? cur : r.next;
    trail.textContent = (trail.textContent ? trail.textContent + " → " : "") + r.event + (r.next === "-" ? " (ignored)" : "");
    cur = to; mark(); buttons();
    if (anim) anim.finish();
    const keyboard = e && e.detail === 0;
    if (from === to || reduce.matches || keyboard) { place(to); return; }
    const p = S("path", { d: edgePath(pos.get(from), pos.get(to)) }); svg.append(p);
    const L = p.getTotalLength(), frames = [];
    for (let i = 0; i <= 24; i++) { const q = p.getPointAtLength(L * i / 24); frames.push({ transform: "translate(" + q.x + "px," + q.y + "px)" }); }
    p.remove();
    const b = pos.get(to); frames.push({ transform: "translate(" + (b.x + b.w - 8) + "px," + (b.y + 8) + "px)" });
    place(to);
    anim = marker.animate(frames, { duration: 200, easing: "cubic-bezier(0.23, 1, 0.32, 1)" });
  }
  function buttons() {
    bar.replaceChildren($("span", { class: "now", text: "Fire an event in " + cur + ":" }));
    const rs = rowsFor(cur);
    if (!rs.length) bar.append($("span", { class: "muted", text: m.final.includes(cur) ? "final state" : "no event leaves this state" }));
    for (const r of rs) {
      const b = $("button", { class: "button", type: "button", "data-ignored": r.next === "-" }, r.event);
      if (r.guard) b.append($("small", { text: "[" + r.guard + "]" }));
      b.addEventListener("click", (e) => fire(r, e));
      bar.append(b);
    }
    const reset = $("button", { class: "button", type: "button" }, "Reset");
    reset.addEventListener("click", () => { cur = m.initial; trail.textContent = ""; if (anim) anim.finish(); place(cur); mark(); buttons(); });
    bar.append(reset);
  }
  place(cur); mark(); buttons();
  host.append(bar, trail);
}

function decide(id, kind) {
  return $("td", { class: "dcell" }, $("div", { class: "decide" },
    $("label", {}, $("input", { type: "radio", name: id, value: "approve", "data-kind": kind }), "Approve"),
    $("label", {}, $("input", { type: "radio", name: id, value: "reject", "data-kind": kind }), "Reject"),
    $("input", { type: "text", name: id + ":comment", placeholder: "Comment", "aria-label": "Comment on " + id })));
}

function rowsTable(m, review) {
  const t = $("table");
  t.append($("tr", {}, ...["state", "event", "guard", "next", "req", "source", "findings"].concat(review ? ["review"] : []).map((h) => $("th", { text: h }))));
  for (const r of m.rows) {
    const id = rowId(m.name, r);
    const tr = $("tr", { id, "data-item": id });
    const tags = $("td");
    for (const f of lineFinds(DATA.checks, m.name, r)) tags.append($("span", { class: "tag", text: BUGS[f.kind] }));
    for (const f of lineFinds(m.simplify, m.name, r)) tags.append($("span", { class: "tag", "data-kind": "simplify", text: SIMP[f.kind] }));
    tr.append($("td", { text: r.state }), $("td", { text: r.event }), $("td", { text: r.guard }), $("td", { text: r.next === "-" ? "— (ignored)" : r.next }),
      $("td", { class: "mono", text: r.reqs.join(" ") || "—" }), $("td", { class: "src", text: r.source }), tags);
    if (review) tr.append(decide(id, "row"));
    t.append(tr);
  }
  return $("div", { class: "rows" }, t);
}

function main() {
  head();
  findings();
  for (const m of DATA.machines) {
    const prop = DATA.proposals.find((p) => p.name === m.name);
    app.append($("h2", { text: "Machine " + m.name }));
    const pair = $("div", { class: "pair", "data-two": !!prop });
    const bad = new Set(DATA.checks.filter((f) => f.machine === m.name && ["unreachable", "dead-end", "unhandled"].includes(f.kind)).map((f) => f.at));
    const a = $("div", { class: "card" }, $("h3", { text: prop ? "Current" : "Diagram" }));
    pair.append(a); app.append(pair); machine(m, a, bad);
    if (prop) {
      const b = $("div", { class: "card" }, $("h3", { text: "Simpler: " + prop.rows.length + " rows, not " + m.rows.length }), $("p", { class: "muted", text: prop.reason }));
      pair.append(b); machine(prop, b, new Set());
    }
    app.append($("h3", { text: "Rows" }), rowsTable(m, true));
    if (prop) app.append($("h3", { text: "Rows of the simpler design" }), rowsTable(prop, false));
  }
  app.append($("h2", { text: "Requirements" }));
  const t = $("table", { class: "reqs" });
  t.append($("tr", {}, ...["id", "requirement", "source", "review"].map((h) => $("th", { text: h }))));
  for (const r of DATA.reqs) t.append($("tr", { "data-item": r.id }, $("td", { text: r.id }), $("td", {}, ...rich(r.text)), $("td", { class: "src", text: r.source }), decide(r.id, "requirement")));
  app.append($("div", { class: "rows" }, t));
  app.append($("p", { class: "muted", text: "A rejected row is deleted with its requirement. A found bug gets a failing test; no fix lands before you approve it here." }));
}

function items() {
  const out = [];
  for (const tr of document.querySelectorAll("tr[data-item]")) {
    const id = tr.dataset.item, d = tr.querySelector("input[type=radio]:checked"), c = tr.querySelector("input[type=text]")?.value.trim();
    tr.dataset.decision = d ? d.value : "";
    if (d || c) out.push({ id, decision: d ? d.value : "comment", comment: c || "" });
  }
  return out;
}
function bar() {
  const form = document.getElementById("bar"), count = document.getElementById("count"), status = document.getElementById("status");
  document.addEventListener("input", (e) => { if (e.target.closest("main")) { const n = items().length; count.textContent = n ? n + " item(s) decided" : "No decisions yet."; } });
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const list = items();
    if (!list.length) { status.textContent = "Decide on a row first."; return; }
    const text = "State machine review of " + DATA.file + ":\n" + list.map((i) => i.id + ": " + i.decision + (i.comment ? " — " + i.comment : "")).join("\n");
    if (window.lavish?.queuePrompt) {
      window.lavish.queuePrompt("Apply this state machine review of " + DATA.file + ". Delete each rejected row and its requirement, keep each approved row, answer each comment, then run sm-axi check and render again. Account for every submitted ID.", { tag: "tracked-batch", text: "Review: " + list.length + " items", element: form, data: { items: list } });
      status.textContent = "Queued. Press Send to agent.";
      return;
    }
    try { await navigator.clipboard.writeText(text); status.textContent = "Copied the review. Paste it to the agent."; }
    catch { form.querySelector("textarea")?.remove(); const ta = $("textarea", { rows: 6, readonly: true, "aria-label": "Review to copy" }); ta.value = text; form.append(ta); ta.select(); status.textContent = "Copy the review below."; }
  });
  addEventListener("load", () => { if (!window.lavish) form.querySelector("button").textContent = "Copy the review"; });
}
main(); bar();
</script></body></html>`;

// ---------- main ----------

const argv = process.argv.slice(2);
if (!argv.length || argv.includes("--help") || argv.includes("-h")) { process.stdout.write(USAGE + "\n"); process.exit(0); }
const [cmd, file] = argv;
const oi = argv.indexOf("--out");
if (cmd === "check") process.exit(check(file));
else if (cmd === "render") process.exit(render(file, oi > 0 ? argv[oi + 1] : ""));
else fail(`unknown command ${cmd}`);
