#!/usr/bin/env node
// sm-axi: check a state machine file and render its review page. One file, no dependencies.
// Usage: sm-axi check <file.sm.md> | sm-axi render <file.sm.md> [--out <file.html>]
// The file format and each finding are in ../references/format.md.
"use strict";
const fs = require("fs");
const path = require("path");

const USAGE = `usage: sm-axi <command> <file.sm.md> [flags]
commands[2]:
  check=run the simplify findings and the 7 checks (exit 1 when a check finds a fault)
  render=write the review page (default: <file>.html)
flags[2]:
  --out <file.html> (render), --help
examples:
  sm-axi check chat.sm.md
  sm-axi render chat.sm.md --out review/chat.html`;

// ---------- parse ----------

function cells(line) {
  const out = [];
  let cur = "";
  const body = line.trim().replace(/^\|/, "").replace(/\|$/, "");
  for (let i = 0; i < body.length; i++) {
    if (body[i] === "\\" && body[i + 1] === "|") { cur += "|"; i++; }
    else if (body[i] === "|") { out.push(cur.trim()); cur = ""; }
    else cur += body[i];
  }
  out.push(cur.trim());
  return out.map((c) => c.replace(/^`(.*)`$/, "$1"));
}

const COLS = ["state", "event", "guard", "next", "req", "source"];

function parse(text, file) {
  const lines = text.split(/\r?\n/);
  const doc = { file, title: "", intro: [], reqs: [], bugs: [], machines: [], proposals: [], errors: [] };
  let sec = null;
  let head = null;
  lines.forEach((raw, i) => {
    const n = i + 1;
    const line = raw.trim();
    let m;
    if ((m = line.match(/^#\s+(.+)$/))) { doc.title = m[1]; return; }
    if ((m = line.match(/^##\s+(.+)$/))) {
      head = null;
      const h = m[1].trim();
      if (/^requirements$/i.test(h)) sec = { kind: "reqs" };
      else if (/^bugs$/i.test(h)) sec = { kind: "bugs" };
      else if ((m = h.match(/^(machine|proposal)\s+([\w.-]+)$/i))) {
        sec = { kind: m[1].toLowerCase(), name: m[2], initial: "", final: [], rows: [], line: n };
        (sec.kind === "machine" ? doc.machines : doc.proposals).push(sec);
      } else sec = null;
      return;
    }
    if (!sec) { if (doc.title && line && !doc.machines.length) doc.intro.push(line); return; }
    if (sec.kind === "reqs" || sec.kind === "bugs") {
      if ((m = line.match(/^[-*]\s+([A-Za-z][\w.-]*)\s*:\s*(.+)$/))) {
        const parts = m[2].split(/\s+(?:—|--)\s+/);
        const what = sec.kind === "reqs" ? "requirement" : "bug";
        if (parts.length < 2) doc.errors.push(`L${n}: ${what} ${m[1]} has no ${sec.kind === "reqs" ? "source" : "proof"} (write "text — ${sec.kind === "reqs" ? "source" : "failing test"}")`);
        doc[sec.kind].push({ id: m[1], text: parts[0].trim(), source: parts.slice(1).join(" — ").trim(), line: n });
      }
      return;
    }
    if ((m = line.match(/^initial\s*:\s*(.*)$/i))) { sec.initial = m[1].trim(); return; }
    if ((m = line.match(/^final\s*:\s*(.*)$/i))) { sec.final = m[1].split(",").map((s) => s.trim()).filter(Boolean); return; }
    if (!line.startsWith("|")) return;
    const c = cells(line);
    if (!head) { head = c.map((x) => x.toLowerCase()); return; }
    if (c.every((x) => /^:?-+:?$/.test(x))) return;
    const row = { line: n };
    COLS.forEach((k) => { const j = head.indexOf(k); row[k] = j < 0 ? "" : (c[j] || ""); });
    row.reqs = row.req && row.req !== "-" ? row.req.split(/[,\s]+/).filter(Boolean) : [];
    if (row.guard === "-") row.guard = "";
    if (!row.state || !row.event || !row.next) doc.errors.push(`L${n}: a row needs state, event and next`);
    sec.rows.push(row);
  });
  for (const mc of [...doc.machines, ...doc.proposals]) {
    if (!mc.initial) doc.errors.push(`L${mc.line}: ${mc.kind} ${mc.name} has no "initial:" line`);
  }
  if (!doc.machines.length) doc.errors.push("no \"## Machine <name>\" section");
  return doc;
}

// ---------- analyse ----------

const norm = (g) => g.replace(/\s+/g, " ").trim();
const neg = (g) => { const x = norm(g); const m = x.match(/^(?:!|not )\s*\(?(.+?)\)?$/); return m ? m[1] : null; };

function analyse(mc, reqIds) {
  const finals = new Set(mc.final);
  const states = [];
  const add = (s) => { if (s && s !== "*" && s !== "-" && !states.includes(s)) states.push(s); };
  add(mc.initial);
  mc.rows.forEach((r) => { add(r.state); add(r.next); });
  mc.final.forEach(add);
  const live = states.filter((s) => !finals.has(s));
  // A "*" row applies to each non-final state with no own row for its event. A guarded "*" row
  // applies to each non-final state with no own row for its event and guard.
  const own = (s, r) => mc.rows.some((o) => o.state === s && o.event === r.event && (!r.guard || norm(o.guard) === norm(r.guard)));
  const eff = [];
  for (const r of mc.rows) {
    if (r.state !== "*") { eff.push(r); continue; }
    for (const s of live) if (!own(s, r)) eff.push({ ...r, state: s, wild: true });
  }
  const events = [...new Set(mc.rows.map((r) => r.event))];
  const out = (s) => eff.filter((r) => r.state === s);
  const checks = [];
  const simplify = [];
  const at = (r) => `${r.state}/${r.event}`;
  const find = (list, kind, where, line, detail) => list.push({ kind, machine: mc.name, at: where, line, detail });

  // reachable
  const seen = new Set();
  const queue = mc.initial ? [mc.initial] : [];
  while (queue.length) {
    const s = queue.shift();
    if (seen.has(s)) continue;
    seen.add(s);
    out(s).forEach((r) => { if (r.next !== "-") queue.push(r.next); });
  }
  for (const s of states) if (!seen.has(s)) find(checks, "unreachable", s, 0, "no path from the initial state");
  for (const s of live) {
    if (!seen.has(s)) continue;
    if (!out(s).some((r) => r.next !== "-" && r.next !== s)) find(checks, "dead-end", s, 0, "no exit and not final");
    const miss = events.filter((e) => !out(s).some((r) => r.event === e));
    if (miss.length) find(checks, "unhandled", s, 0, `events: ${miss.join(" ")}`);
  }
  // groups of one state and one event
  const groups = new Map();
  for (const r of eff) {
    const k = at(r);
    if (!groups.has(k)) groups.set(k, []);
    groups.get(k).push(r);
  }
  for (const [k, g] of groups) {
    if (g.length < 2) {
      if (g[0].guard && norm(g[0].guard) !== "else") find(checks, "guard-gap", k, g[0].line, `only "${g[0].guard}": add an else row`);
      continue;
    }
    const gs = g.map((r) => norm(r.guard));
    const dup = gs.some((x, i) => gs.indexOf(x) !== i) || gs.includes("");
    if (dup) { find(checks, "two-transitions", k, g[1].line, `${g.length} rows with overlapping guards`); continue; }
    const covered = gs.includes("else") || (gs.length === 2 && (neg(gs[0]) === gs[1] || neg(gs[1]) === gs[0]));
    if (!covered) find(checks, "guard-gap", k, g[0].line, `guards ${gs.join(" | ")} do not show full cover: add an else row`);
  }
  for (const r of mc.rows) {
    const bad = r.reqs.filter((id) => !reqIds.has(id));
    if (!r.reqs.length) find(checks, "row-no-req", at(r), r.line, "no requirement");
    else if (bad.length) find(checks, "row-no-req", at(r), r.line, `unknown requirement ${bad.join(" ")}`);
  }

  // simplify: equivalent states (Moore minimisation)
  let cls = new Map(states.map((s) => [s, finals.has(s) ? "F" : "N"]));
  for (let round = 0; round <= states.length; round++) {
    const sig = new Map(states.map((s) => [s, cls.get(s) + "|" + out(s).map((r) => `${r.event}[${norm(r.guard)}]${r.next === "-" ? "~" : ">" + cls.get(r.next)}`).sort().join(",")]));
    const ids = new Map();
    const next = new Map(states.map((s) => { const k = sig.get(s); if (!ids.has(k)) ids.set(k, String(ids.size)); return [s, ids.get(k)]; }));
    const stable = new Set(next.values()).size === new Set(cls.values()).size;
    cls = next;
    if (stable) break;
  }
  const byCls = new Map();
  states.forEach((s) => { const c = cls.get(s); byCls.set(c, [...(byCls.get(c) || []), s]); });
  for (const g of byCls.values()) if (g.length > 1) find(simplify, "merge-states", g.join("+"), 0, "same rows to the same states");
  // pass-through states
  for (const s of states) {
    if (s === mc.initial || finals.has(s)) continue;
    const ins = eff.filter((r) => r.next === s && r.state !== s);
    const outs = mc.rows.filter((r) => r.state === s && r.next !== "-" && r.next !== s);
    if (ins.length !== 1 || outs.length !== 1 || outs[0].guard) continue;
    if (outs[0].reqs.every((id) => ins[0].reqs.includes(id))) find(simplify, "pass-through", s, outs[0].line, `${ins[0].state} -> ${s} -> ${outs[0].next}: delete ${s}`);
  }
  // one event, guard and next state in many states
  const glob = new Map();
  for (const r of mc.rows) {
    if (r.state === "*") continue;
    const k = `${r.event}|${norm(r.guard)}|${r.next}`;
    glob.set(k, [...(glob.get(k) || []), r]);
  }
  for (const [k, g] of glob) {
    const ss = [...new Set(g.map((r) => r.state))];
    if (ss.length >= 3) { const [e, , n] = k.split("|"); find(simplify, "global-event", e, g[0].line, `${ss.length} rows (${ss.join(" ")}) -> ${n}: write one * row`); }
  }
  // flags: guard atoms in many rows, state names that combine flags
  const atoms = new Map();
  for (const r of mc.rows) {
    if (!r.guard || norm(r.guard) === "else") continue;
    for (let a of r.guard.split(/&&|\|\||\band\b|\bor\b/)) {
      a = a.trim().replace(/^(!|not\s+)/, "").replace(/^\(|\)$/g, "").trim();
      if (!a) continue;
      const v = atoms.get(a) || { rows: 0, states: new Set(), line: r.line };
      v.rows++; v.states.add(r.state); atoms.set(a, v);
    }
  }
  for (const [a, v] of atoms) if (v.rows >= 3 && v.states.size >= 2) find(simplify, "flag-guard", a, v.line, `${v.rows} rows in ${v.states.size} states test it: a hidden state?`);
  const tok = (s) => s.split(/[_+-]/).filter(Boolean);
  const count = new Map();
  states.forEach((s) => tok(s).forEach((t) => count.set(t, (count.get(t) || 0) + 1)));
  const combos = states.filter((s) => tok(s).length >= 2 && tok(s).every((t) => count.get(t) >= 2));
  if (combos.length >= 3) find(simplify, "flag-states", combos.join(" "), 0, "state names combine flags: one machine for each flag?");
  // a plain function?
  const edges = new Map(states.map((s) => [s, [...new Set(out(s).filter((r) => r.next !== "-" && r.next !== s).map((r) => r.next))]]));
  const branchless = [...edges.values()].every((e) => e.length <= 1);
  let cyclic = false;
  const mark = new Map();
  const dfs = (s) => { mark.set(s, 1); for (const t of edges.get(s) || []) { if (mark.get(t) === 1) cyclic = true; else if (!mark.get(t)) dfs(t); } mark.set(s, 2); };
  states.forEach((s) => { if (!mark.get(s)) dfs(s); });
  if (states.length <= 2 || (branchless && !cyclic)) find(simplify, "function", mc.name, 0, "no branch and no loop: is a plain function better?");

  const cited = new Set(mc.rows.flatMap((r) => r.reqs).filter((id) => reqIds.has(id)));
  return { states, events, eff, checks, simplify, cited, rows: mc.rows.length };
}

function run(doc) {
  const reqIds = new Set(doc.reqs.map((r) => r.id));
  const res = doc.machines.map((m) => ({ m, a: analyse(m, reqIds) }));
  const checks = res.flatMap((x) => x.a.checks);
  const cited = new Set(res.flatMap((x) => [...x.a.cited]));
  for (const r of doc.reqs) if (!cited.has(r.id)) checks.push({ kind: "req-no-row", machine: "-", at: r.id, line: r.line, detail: "no row cites it" });
  const proposals = doc.proposals.map((p) => {
    const cur = res.find((x) => x.m.name === p.name);
    const a = analyse(p, reqIds);
    let reason = "";
    if (!cur) reason = `no machine ${p.name}`;
    else {
      const lost = [...cur.a.cited].filter((id) => !a.cited.has(id));
      if (lost.length) reason = `drops ${lost.join(" ")}`;
      else if (a.rows >= cur.a.rows) reason = `${a.rows} rows, not fewer than ${cur.a.rows}`;
      else if (a.checks.length) reason = `${a.checks.length} check findings`;
    }
    return { p, a, cur: cur ? cur.a.rows : 0, status: reason ? "hidden" : "shown", reason: reason || "keeps each requirement, fewer rows, passes the checks" };
  });
  return { res, checks, proposals, reqIds };
}

// ---------- TOON output ----------

const q = (v) => {
  const s = String(v);
  return s === "" || /[,:"\n]|^\s|\s$/.test(s) ? `"${s.replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/\n/g, "\\n")}"` : s;
};
function table(name, keys, list) {
  if (!list.length) return `${name}: []`;
  return `${name}[${list.length}]{${keys.join(",")}}:\n` + list.map((o) => "  " + keys.map((k) => q(o[k])).join(",")).join("\n");
}
function help(lines) { return `help[${lines.length}]:\n` + lines.map((l) => "  " + l).join("\n"); }

function check(file) {
  const doc = load(file);
  const { res, checks, proposals } = run(doc);
  const ratio = (a) => (doc.reqs.length ? (a.rows / Math.max(1, a.cited.size)).toFixed(1) : "-");
  const out = [`file: ${q(path.basename(file))}`];
  out.push(table("machines", ["name", "states", "events", "rows", "reqs", "rows_per_req"],
    res.map(({ m, a }) => ({ name: m.name, states: a.states.length, events: a.events.length, rows: a.rows, reqs: a.cited.size, rows_per_req: ratio(a) }))));
  const simplify = res.flatMap((x) => x.a.simplify);
  if (doc.bugs.length) out.push(table("bugs", ["id", "proof"], doc.bugs.map((b) => ({ id: b.id, proof: b.source }))));
  out.push(table("simplify", ["kind", "machine", "at", "line", "detail"], simplify.map(withLine)));
  out.push(table("checks", ["kind", "machine", "at", "line", "detail"], checks.map(withLine)));
  if (proposals.length) out.push(table("proposals", ["machine", "rows", "current_rows", "status", "reason"],
    proposals.map((x) => ({ machine: x.p.name, rows: x.a.rows, current_rows: x.cur, status: x.status, reason: x.reason }))));
  const h = [];
  if (checks.length) h.push(`Fix each check finding in ${path.basename(file)}, or ask the owner to reject its row; then run \`sm-axi check ${file}\` again`);
  if (simplify.length) h.push("Write a simpler design as \"## Proposal <machine>\"; it shows only if it keeps each requirement, has fewer rows and passes the checks");
  h.push(`Run \`sm-axi render ${file}\` to write the review page`);
  out.push(help(h));
  process.stdout.write(out.join("\n") + "\n");
  return checks.length ? 1 : 0;
}
const withLine = (f) => ({ ...f, line: f.line ? `L${f.line}` : "-" });

function load(file) {
  if (!file) fail("missing <file.sm.md>");
  let text;
  try { text = fs.readFileSync(file, "utf8"); } catch (e) { fail(`cannot read ${file}: ${e.code || e.message}`); }
  const doc = parse(text, file);
  if (doc.errors.length) {
    process.stdout.write(`error: ${q(path.basename(file))} does not parse\n` + table("errors", ["at"], doc.errors.map((e) => ({ at: e }))) + "\n" +
      help(["Fix each error; the format is in references/format.md"]) + "\n");
    process.exit(2);
  }
  return doc;
}
function fail(msg) { process.stdout.write(`error: ${q(msg)}\n${USAGE}\n`); process.exit(2); }

// ---------- render ----------

function render(file, outPath) {
  const doc = load(file);
  const { res, checks, proposals } = run(doc);
  const pack = (m, a) => ({
    name: m.name, initial: m.initial, final: m.final, states: a.states, events: a.events,
    rows: m.rows.map((r) => ({ line: r.line, state: r.state, event: r.event, guard: r.guard, next: r.next, reqs: r.reqs, source: r.source })),
    simplify: a.simplify,
  });
  const data = {
    title: doc.title || path.basename(file), file: path.basename(file),
    intro: doc.intro,
    reqs: doc.reqs.map(({ id, text, source }) => ({ id, text, source })),
    bugs: doc.bugs.map(({ id, text, source }) => ({ id, text, source })),
    machines: res.map(({ m, a }) => pack(m, a)),
    proposals: proposals.filter((x) => x.status === "shown").map((x) => ({ ...pack(x.p, x.a), reason: x.reason })),
    hidden: proposals.filter((x) => x.status !== "shown").map((x) => ({ name: x.p.name, reason: x.reason })),
    checks,
  };
  const target = outPath || file.replace(/(\.sm)?\.md$/, "") + ".html";
  const json = JSON.stringify(data).replace(/</g, "\\u003c");
  fs.mkdirSync(path.dirname(path.resolve(target)), { recursive: true });
  fs.writeFileSync(target, PAGE.replace("/*DATA*/null", json).replace("<!--TITLE-->", esc(data.title)));
  process.stdout.write(`wrote: ${q(target)}\n` + help([
    `Run \`lavish-axi ${target}\` to open the review board; approve, reject or comment on each row there`,
    "Without lavish-axi, open the file in a browser; \"Copy the review\" puts the decisions on the clipboard",
  ]) + "\n");
  return 0;
}
const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);

// The page. Look: the tokens of teoyujie.org/shared/kowalski.css (light only, as the site).
// Motion (animation-vocabulary names): the current-state marker is a Translate along the edge,
// a Tween of 200 ms with the strong Ease-out, for Spatial consistency. Buttons have Press / Tap
// feedback (scale 0.97, 150 ms). A keyboard-fired event and Reduced motion get no movement.
const PAGE = String.raw`<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><!--TITLE--></title>
<style>
:root { --bg: #fdfdfc; --chip: #f9f9f8; --line: #e9e9e7; --select: #e2e1de; --underline: #bcbbb5; --muted: #63635e; --ink: #21201c;
  --hover: #f5f4f4; --card: #fff; --card-edge: rgba(0,0,0,.08); --shadow: 0 4px 12px rgba(0,0,0,.1);
  --sans: "Inter", "Inter Fallback", Arial, sans-serif; --mono: "IBM Plex Mono", ui-monospace, monospace;
  --small: 0.875rem; --code: 0.8125rem; --radius: 6px; --press: 0.97; --press-duration: 150ms; --tap: 44px;
  --ease-out: cubic-bezier(0.23, 1, 0.32, 1); --gray1: #fcfcfc; --gray2: #f8f8f8; --gray3: #f3f3f3; --gray4: #ededed; --gray7: #dbdbdb;
  --fade-duration: 150ms; --bad: #b4321f; --bad-bg: #fbeeec; --good: #2f6b3a; --good-bg: #edf5ee;
  --focus-ring: 0 0 0 1px rgba(0,0,0,.06), 0 1px 0 0 rgba(0,0,0,.08), 0 0 0 2px rgba(0,0,0,.15); }
@font-face { font-family: "Inter Fallback"; src: local("Arial"); size-adjust: 107.12%; ascent-override: 90.44%; descent-override: 22.52%; line-gap-override: 0%; }
* { box-sizing: border-box; outline-color: var(--muted); }
::selection { background: var(--select); }
html { -webkit-text-size-adjust: 100%; -webkit-tap-highlight-color: transparent; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 1rem/1.5 var(--sans); -webkit-font-smoothing: antialiased; }
main { max-width: 1120px; margin: 0 auto; padding: 32px 16px 96px; }
h1 { font-size: 1.5rem; font-weight: 600; letter-spacing: -0.01em; margin: 0 0 4px; }
h2 { font-size: 1.125rem; font-weight: 600; margin: 40px 0 12px; }
h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }
p, li { max-width: 70ch; }
.muted { color: var(--muted); font-size: var(--small); }
a { color: inherit; text-decoration: underline 0.08em var(--underline); text-underline-position: from-font; }
@media (hover: hover) and (pointer: fine) { a:hover { text-decoration-color: #8d8d86; } }
code, .mono { font-family: var(--mono); font-size: var(--code); }
.verdict { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 0; padding: 0; list-style: none; }
.verdict li { background: var(--chip); border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; font-size: var(--small); }
.verdict li[data-bad] { background: var(--bad-bg); border-color: #f0cfc9; color: var(--bad); }
.finds { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 6px; }
.finds li[data-bug] { border-color: #f0cfc9; }
.finds li { background: var(--card); border: 1px solid var(--card-edge); border-radius: var(--radius); padding: 8px 12px; font-size: var(--small); max-width: none; }
.finds b { font-family: var(--mono); font-weight: 500; margin-right: 8px; }
.pair { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
@media (min-width: 900px) { .pair[data-two] { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
.card { background: var(--card); border: 1px solid var(--card-edge); border-radius: 10px; padding: 16px; min-width: 0; }
.graph { overflow-x: auto; margin: 0 -4px; }
svg { display: block; font-family: var(--sans); width: 100%; height: auto; }
.node rect { fill: var(--gray1); stroke: var(--gray7); }
.node[data-final] rect { stroke-width: 3; stroke: var(--gray7); }
.node[data-bad] rect { fill: var(--bad-bg); stroke: #e3a69c; }
.node[data-current] rect { fill: var(--ink); stroke: var(--ink); }
.node[data-current] text { fill: var(--bg); }
.node text { font-size: 13px; fill: var(--ink); }
.edge { fill: none; stroke: var(--underline); stroke-width: 1.25; }
.edge[data-wild] { stroke-dasharray: 4 4; }
